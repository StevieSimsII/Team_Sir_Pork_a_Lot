# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.venv/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
__pycache__/
*.py[cod]

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# local tooling
.claude/worktrees/

# generated local outputs
dashboard/dist/
data/generated/
*.xlsx

# typescript
*.tsbuildinfo
next-env.d.ts
