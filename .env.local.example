# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Power Automate webhook secret — pick any long random string
# Used in the Authorization: Bearer <token> header by Power Automate
MARK_PAID_SECRET=replace-with-a-long-random-secret

